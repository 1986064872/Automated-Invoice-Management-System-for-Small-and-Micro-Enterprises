# ==========================================================================
#  忽略规则 —— 这个文件里每一条都别随手删，理由写在注释里
#  核心原则：**真实票据、密钥、个人日志绝不进仓库**
# ==========================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 环境变量与密钥：绝对不能提交 ----
.env
backend/.env
*.key

# ---- 运行时数据：数据库、原票、回收站、DB 备份、导出 ----
# 整个 data/ 一起忽略，比逐个列子目录保险（以后新增子目录也不会漏）。
# 这里有**客户真实发票**：税号、银行账号、金额，属于第三方商业数据。
data/
*.db
*.sqlite
*.sqlite3

# ---- 真实发票素材 ----
# 素材/测试发票/ 里是真实企业的发票，公开仓库会泄露第三方信息。
# 需要演示数据请用 backend/testdata/测试发票公开版/（完全合成版）。
素材/

# ---- 本地隐私扫描词表（含真实企业名/税号/人名）----
# 只放在本机，供 check_no_real_data.py 使用。
backend/scripts/anonymize_map.local.json

# check_no_real_data.py 的额外扫描词表（票号/账号/工程名等）
backend/scripts/check_patterns.local.txt

# ---- 临时探针（下划线开头的脚本/输出，用完即删）----
# 这类文件是排障时临时写的，输出里经常带本机用户目录绝对路径，
# 一律不进仓库。
backend/scripts/_*.py
backend/scripts/_*.json

# ---- 旧版尝试 ----
# 里面也有真实票据、invoices.db 和台账 Excel，一律不上传（本地留着即可）。
1/

# ---- 工作区记忆 ----
# .workbuddy/memory/ 是开发日志，写了客户名、项目决策与个人信息，不适合公开。
.workbuddy/

# ---- 台账类导出 ----
*.xlsx

# ---- 前端 ----
node_modules/
frontend/dist/
frontend/.vite/
*.local

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
